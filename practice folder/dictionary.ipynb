    "\n",
    "data = np.array([26, 47, 33, 29, 41, 38, 24, 50, 35, 44, 28, 32, 49, 23, 37, 46, 30, 27, 42, 25, 39, 48, 31, 22, 43, 34, 40, 45, 21, 36])\n",
