    "colors=[\"red , blue , green , yellow , orange , purple , pink , brown , grey , cyan , magenta , lime , navy , teal , maroon , olive , silver , gold , coral , lavender , beige , mint , apricot , peach , chocolate , tan , salmon , khaki , ivory , plum\"]\n",
    "\n",
    "plt.pie(x, colors=colors)\n",
