    "total = sum(data_above_30)\n",
    "# print(data_above_30)\n",
    "data_below_30 = data[data < 30]\n",
    "total_b = sum(data_below_30)\n",
    "# print(data_below_30)\n",
    "percentage_above_30 = total * 30 /100\n",
    "print(percentage_above_30)\n",
    "percentage_below_30 = total_b * 30 /100\n",
    "print(percentage_below_30)\n",
    "total_percentage = percentage_above_30 + percentage_below_30\n",
    "print(total_percentage)"
   ]
